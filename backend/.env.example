# ---- Required ----
DATABASE_URL=postgres://user:pass@host:5432/db
JWT_SECRET=change-me-min-32-chars
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Optional ----
PORT=5000
NODE_ENV=development

# Resend (password reset OTP emails)
# Get a key at https://resend.com/api-keys. NEVER commit the real key.
RESEND_API_KEY=re_xxx

# Sender shown on password-reset emails. Development uses Resend's shared
# sender which needs NO custom domain or DNS verification.
# Format: "Name <email>".
EMAIL_FROM=Vestro <onboarding@resend.dev>

# Redis (optional, used for queues/caching)
REDIS_URL=redis://localhost:6379

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com